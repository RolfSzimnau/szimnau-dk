---
import type { Lang } from '../i18n/ui';
import { useTranslations, switchLocale } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const currentPath = Astro.url.pathname;
const langs: Lang[] = ['en', 'da', 'de'];
const langNames = { en: 'English', da: 'Dansk', de: 'Deutsch' } as const;
const navItems = [
  { href: `/${lang}/`, label: t('nav.home'), active: currentPath === `/${lang}/` },
  { href: `/${lang}/blog/`, label: t('nav.blog'), active: currentPath.startsWith(`/${lang}/blog`) },
  { href: `/${lang}/about/`, label: t('nav.about'), active: currentPath.startsWith(`/${lang}/about`) },
  { href: `/${lang}/#hardware-lab`, label: t('nav.hardware'), active: false },
];
---

<div id="header-sentinel" class="absolute top-0 left-0 h-5 w-px pointer-events-none" aria-hidden="true"></div>
<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
  <nav aria-label="Main" class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href={`/${lang}/`} class="flex items-center gap-2 font-mono font-bold text-lg tracking-tight hover:opacity-80 transition-opacity">
      <span class="text-navy bg-blue px-2 py-1 rounded-full text-sm">R</span>
      <span class="text-blue">szimnau<span class="text-text-muted">.dk</span></span>
    </a>

    <div class="hidden md:flex items-center gap-8">
      {navItems.map(item => (
        <a
          href={item.href}
          aria-current={item.active ? 'page' : undefined}
          class={`transition-colors text-sm font-medium ${item.active ? 'text-text-primary' : 'text-text-muted hover:text-blue'}`}
        >
          {item.label}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-1" role="group" aria-label={t('nav.language')}>
      {langs.map(l => (
        <a
          href={switchLocale(currentPath, l)}
          hreflang={l}
          lang={l}
          aria-label={langNames[l]}
          aria-current={l === lang ? 'true' : undefined}
          class={`font-mono text-xs px-2.5 py-1 rounded-full transition-all ${
            l === lang
              ? 'bg-blue text-navy font-bold'
              : 'text-text-muted hover:text-blue border border-glass-border hover:border-blue/40'
          }`}
        >
          {l.toUpperCase()}
        </a>
      ))}

      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden ml-2 p-2 text-text-muted hover:text-blue transition-colors"
        aria-label={t('nav.menu')}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="menu-icon-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="4" y1="7" x2="20" y2="7" />
          <line x1="4" y1="12" x2="20" y2="12" />
          <line x1="4" y1="17" x2="20" y2="17" />
        </svg>
        <svg id="menu-icon-close" class="hidden" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="6" y1="6" x2="18" y2="18" />
          <line x1="18" y1="6" x2="6" y2="18" />
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden md:hidden bg-navy/95 backdrop-blur-md border-b border-glass-border">
    <div class="max-w-6xl mx-auto px-6 py-4 flex flex-col gap-4">
      {navItems.map(item => (
        <a
          href={item.href}
          aria-current={item.active ? 'page' : undefined}
          class={`transition-colors text-sm font-medium ${item.active ? 'text-text-primary' : 'text-text-muted hover:text-blue'}`}
        >
          {item.label}
        </a>
      ))}
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  menuBtn?.addEventListener('click', () => {
    const open = mobileMenu?.classList.toggle('hidden') === false;
    menuBtn.setAttribute('aria-expanded', String(open));
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
  });
  mobileMenu?.querySelectorAll('a').forEach(a =>
    a.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      menuBtn?.setAttribute('aria-expanded', 'false');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    })
  );

  const header = document.getElementById('site-header');
  const sentinel = document.getElementById('header-sentinel');
  const stuck = ['bg-navy/80', 'backdrop-blur-md', 'border-b', 'border-glass-border'];
  if (header && sentinel && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      stuck.forEach(c => header.classList.toggle(c, !entry.isIntersecting));
    }).observe(sentinel);
  }
</script>
