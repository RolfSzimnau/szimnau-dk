---
import fs from 'node:fs';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { hardwareGroups } from '../data/hardware';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Phosphor icons inlined at build time. Never emoji or hand-drawn paths.
const iconSvg = (name: string, size = 20) =>
  fs.readFileSync(`node_modules/@phosphor-icons/core/assets/regular/${name}.svg`, 'utf-8')
    .replace('<svg ', `<svg width="${size}" height="${size}" aria-hidden="true" focusable="false" `);
---

<section id="hardware-lab" class="py-24 px-6">
  <div class="max-w-6xl mx-auto">
    <div class="mb-12">
      <h2 class="font-heading text-3xl sm:text-4xl font-bold text-text-primary mb-4">{t('hardware.title')}</h2>
      <p class="text-text-muted max-w-2xl">{t('hardware.subtitle')}</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      {hardwareGroups.map((group, i) => {
        const wide = i === hardwareGroups.length - 1;
        return (
          <div class:list={['glass-card p-6', wide && 'lg:col-span-2']}>
            <h3 class="font-heading text-lg font-bold text-text-primary mb-1">{group.title[lang]}</h3>
            <ul class:list={[wide && 'lg:grid lg:grid-cols-2 lg:gap-x-8']}>
              {group.items.map(item => (
                <li class:list={['flex gap-3 py-3 border-b border-white/[0.06] last:border-0', wide && 'lg:[&:nth-last-child(2)]:border-0']}>
                  <span class="text-blue shrink-0 mt-1" aria-hidden="true" set:html={iconSvg(item.icon)} />
                  <div class="min-w-0">
                    <h4 class="font-heading font-semibold text-text-primary text-[15px] leading-snug">
                      {item.link ? (
                        <a
                          href={item.link}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-block py-1 hover:text-blue focus-visible:text-blue transition-colors"
                        >
                          {item.name}<span class="sr-only"> {t('hardware.vendor')}</span>
                        </a>
                      ) : (
                        <span class="inline-block py-1">{item.name}</span>
                      )}
                    </h4>
                    <p class="text-text-muted text-[15px] leading-relaxed">{item.text[lang]}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        );
      })}
    </div>
  </div>
</section>
